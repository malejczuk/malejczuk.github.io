---
import { getCollection, render } from 'astro:content';
import Gallery from '../../components/Gallery.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const galleries = await getCollection('photography');
	return galleries.map((gallery) => ({ params: { slug: gallery.id }, props: { gallery } }));
}

const { gallery } = Astro.props;
const { title, shot_on, gallery_folder, cover_image, alt } = gallery.data;
// Defaults to the gallery's caption (the text under its title), or where it's from, then what it was shot on.
const caption = gallery.body?.trim().replace(/\s+/g, ' ');
const shotOn = shot_on ? `Shot on ${shot_on}.` : '';
const description = gallery.data.description ?? [caption || `My photographs from ${title}.`, shotOn].filter(Boolean).join(' ');
const { Content } = await render(gallery);
---
<BaseLayout title={title} description={description} image={{ path: cover_image, alt: title }}>
<div class="gallery-header">
<h1>{title}</h1>
{shot_on && <h3>Shot on: {shot_on}</h3>}
</div>

<div class="gallery-description">
  <Content />
</div>

<Gallery folder={gallery_folder} title={title} alt={alt} />
</BaseLayout>
