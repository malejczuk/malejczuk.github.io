---
import { getCollection, render } from 'astro:content';
import WritingMenu from '../../components/WritingMenu.md';
import WritingMenuSpanish from '../../components/WritingMenuSpanish.md';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const pieces = await getCollection('writing');
	return pieces.map((piece) => ({ params: { slug: piece.id }, props: { piece } }));
}

const { piece } = Astro.props;
const { title, date, description, lang, raw } = piece.data;
const { Content } = await render(piece);
---
<BaseLayout title={title} description={description} date={date}>
<div class="writing-layout">
<article class="writing-content" lang={lang}>
  <h1 class="writing-title">{title}</h1>
  {raw ? <Fragment set:html={piece.body} /> : <Content />}

  <div class="sig-wrapper">
    <div>
      <hr />
      <p>Kristoff Malejczuk <br />
{date}</p>
    </div>
  </div>
</article>

<aside class="writing-sidebar">
  <h3 id="writing">Writing</h3>
  <WritingMenu />
  <h4>Spanish</h4>
  <WritingMenuSpanish />
</aside>
</div>
</BaseLayout>
